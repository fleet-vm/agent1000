# Copy to .env.local and fill in. .env.local is gitignored; this file is not,
# and must never hold a real value.
#
# NEXT_PUBLIC_* is inlined into the client bundle at build time. That is correct
# here -- the form posts from the browser, so the endpoint is public by
# necessity -- but it means this is a public URL, not a secret. Never put an API
# key that can do anything other than accept a form submission behind this name,
# and rebuild after changing it: a restart is not enough.
#
# Unset, the "Request a demo" form falls back to opening the visitor's own mail
# client. See src/lib/demoRequest.ts.
NEXT_PUBLIC_FORM_ENDPOINT=

# The site's own origin, no trailing slash. Everything SEO depends on it:
# canonical links, Open Graph URLs, sitemap.xml and robots.txt. Defaults to
# https://agent1000.co.za.
#
# Set it on any deploy that is NOT production -- a staging build that keeps the
# default publishes canonicals pointing at production, which tells Google to
# index production instead of staging. That failure is silent and it is the
# reason this name exists.
NEXT_PUBLIC_SITE_URL=
